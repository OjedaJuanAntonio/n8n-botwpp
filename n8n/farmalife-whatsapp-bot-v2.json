    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT p.nombre,\n       p.marca_proveedor,\n       p.stock,\n       p.precio,\n       p.monodroga,\n       CASE WHEN p.stock > 0 THEN 'DISPONIBLE' ELSE 'SIN_STOCK' END AS estado\nFROM productos p\nWHERE ($2 <> '' AND ($2 = p.codigo_barra OR $2 = p.codigo_farmacia OR $2 = p.troquel))\n   OR ($1 <> '' AND p.nombre % $1)\nORDER BY (p.stock > 0) DESC,\n         CASE WHEN $1 <> '' THEN similarity(p.nombre, $1) ELSE 0 END DESC,\n         p.stock DESC\nLIMIT 5",
        "options": {
          "queryReplacement": "={{ $json.termino_busqueda }},{{ $json.codigo_detectado }}"
        }
      },
      "id": "node-buscar-stock",
      "name": "Buscar Stock",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        2420,
        340
      ],
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Postgres Farmalife (asignar)"
        }
      }
