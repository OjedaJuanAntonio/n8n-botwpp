        "textBody": "=Nueva consulta derivada.\\nFarmacia: {{ $json.farmacia_numero }}\\nMotivo: {{ $json.motivo }}\\nMensaje original: \\\"{{ $json.mensaje_original }}\\\"\\n\\nContactar directo: https://wa.me/{{ $json.farmacia_numero }}"
      },
