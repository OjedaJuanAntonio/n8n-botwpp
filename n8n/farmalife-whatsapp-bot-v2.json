    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT c.nombre, c.numero_whatsapp\nFROM proveedores pr\nJOIN compradores c ON c.id = pr.comprador_id\nWHERE pr.nombre_marca = $1 AND c.activo = TRUE\nLIMIT 1",
        "options": {
          "queryReplacement": "={{ $json.marca_proveedor }}"
        }
      },
      "id": "node-buscar-comprador",
      "name": "Buscar Comprador Asignado",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        2420,
        120
      ],
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Postgres Farmalife (asignar)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const filas = $input.all();\nconst datosClasificacion = $('Parsear JSON Claude').first().json;\n\n// Fallback: si no hay comprador asignado por marca, usar admin general\nconst comprador = filas.length > 0\n  ? filas[0].json\n  : { nombre: 'Administración General', numero_whatsapp: 'CAMBIAR_NUMERO_ADMIN_FALLBACK' };\n\nreturn [{\n  json: {\n    comprador_nombre: comprador.nombre,\n    comprador_numero: comprador.numero_whatsapp,\n    farmacia_numero: datosClasificacion.numero_from,\n    mensaje_original: datosClasificacion.mensaje_original,\n    motivo: datosClasificacion.motivo_derivacion || 'Consulta general'\n  }\n}];"
      },
