    {
      "parameters": {
        "jsCode": "const filas = $input.all().map(i => i.json);\n\nif (filas.length === 0) {\n  return [{ json: {\n    respuesta: 'No encontre ese producto en el catalogo. Te derivo con un asesor para confirmarlo.',\n    sin_resultados: true\n  } }];\n}\n\nconst money = v => (v === null || v === undefined)\n  ? 'precio a confirmar'\n  : '$' + Number(v).toLocaleString('es-AR', { minimumFractionDigits: 2 });\n\nconst disponibles = filas.filter(p => p.estado === 'DISPONIBLE');\nconst agotados    = filas.filter(p => p.estado === 'SIN_STOCK');\n\nlet partes = [];\nif (disponibles.length) {\n  partes.push('Disponible:\n' + disponibles\n    .map(p => `• ${p.nombre} — ${p.stock} u. — ${money(p.precio)}`).join('\n'));\n}\nif (agotados.length) {\n  partes.push('Sin stock por el momento:\n' + agotados\n    .map(p => `• ${p.nombre}`).join('\n'));\n}\n\n// Una sola respuesta consolidada: cada mensaje saliente se factura aparte.\nreturn [{ json: {\n  respuesta: partes.join('\n\n'),\n  sin_resultados: false,\n  hay_disponibles: disponibles.length > 0\n} }];"
      },
