# ============================================================================
# .env.example
# Copiar este archivo a ".env" (setup.sh lo hace automáticamente si no existe)
# y completar los valores reales. El archivo ".env" NUNCA debe subirse a git
# (agregalo a .gitignore) porque va a tener credenciales reales.
# ============================================================================

# ----------------------------------------------------------------------------
# n8n - autenticación básica de acceso a la interfaz web (Basic Auth)
# Esto es lo que te va a pedir el navegador la primera vez que entres a
# http://localhost:5678 (o a la URL de ngrok/Cloudflare Tunnel).
# ----------------------------------------------------------------------------
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=cambiar-esta-password

# ----------------------------------------------------------------------------
# n8n - URL pública del webhook
# WhatsApp Cloud API va a mandar los mensajes entrantes a esta URL, así que
# tiene que ser una URL HTTPS válida y accesible desde internet (no localhost).
# Acá va la URL que te da ngrok o Cloudflare Tunnel, por ejemplo:
#   WEBHOOK_URL=https://abcd-1234.ngrok-free.app/
# Actualizala cada vez que reinicies ngrok (a menos que tengas un dominio fijo).
# ----------------------------------------------------------------------------
WEBHOOK_URL=https://tu-subdominio.ngrok-free.app/

# ----------------------------------------------------------------------------
# n8n - zona horaria (ya viene fijada en docker-compose.yml, pero se puede
# sobreescribir acá si en algún momento necesitás otro huso horario)
# ----------------------------------------------------------------------------
GENERIC_TIMEZONE=America/Argentina/Buenos_Aires

# ----------------------------------------------------------------------------
# Base de datos de NEGOCIO (PostgreSQL) - farmacias, productos, proveedores,
# compradores. Esta es una base de datos separada de la interna de n8n
# (n8n usa SQLite por defecto para sus propios datos de ejecución/credenciales,
# y no la tocamos acá).
# ----------------------------------------------------------------------------
POSTGRES_USER=farmalife_admin
POSTGRES_PASSWORD=cambiar-esta-password-tambien
POSTGRES_DB=farmalife_bot
POSTGRES_PORT=5432

# ----------------------------------------------------------------------------
# WhatsApp Cloud API (Meta / developers.facebook.com)
# IMPORTANTE: estas variables NO se usan en docker-compose.yml. Se obtienen
# haciendo los pasos manuales descriptos en el README.md (creando la app en
# developers.facebook.com) y se pegan directamente en n8n:
#   - Como credencial "Header Auth" o "HTTP Header Auth" (para el Access Token)
#     en el nodo HTTP Request que llama a la Graph API de WhatsApp.
#   - El Phone Number ID se usa en la URL del endpoint de la Graph API, ej:
#     https://graph.facebook.com/v20.0/<PHONE_NUMBER_ID>/messages
# Las dejamos acá comentadas solo como referencia/anotador personal, para que
# no se te pierdan mientras armás las credenciales en n8n. No son leídas por
# ningún contenedor.
# ----------------------------------------------------------------------------
# WHATSAPP_ACCESS_TOKEN=          # Token temporal o permanente de la app de Meta
# WHATSAPP_PHONE_NUMBER_ID=       # Phone Number ID (Configuración de WhatsApp > API Setup)
# WHATSAPP_BUSINESS_ACCOUNT_ID=   # WABA ID (WhatsApp Business Account ID)
# WHATSAPP_VERIFY_TOKEN=          # String inventado por vos, se usa para verificar el webhook
